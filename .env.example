# Variables de entorno para Docker Compose
POSTGRES_DB=flowboard_db         # Nombre de tu base de datos
POSTGRES_USER=flowboard_user     # Usuario de conexión
POSTGRES_PASSWORD=tu_contraseña  # Contraseña de conexión

# Variables de entorno para el frontend
VITE_API_URL=http://localhost:8080/api

# Variables de entorno para el backend
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/flowboard_db # URL de conexión a la base de datos
SPRING_DATASOURCE_USERNAME=flowboard_user       # Usuario de conexión a la base de datos
SPRING_DATASOURCE_PASSWORD=tu_contraseña        # Contraseña de conexión a la base de datos
APP_JWT_SECRET=replace_with_a_long_random_secret  # Clave secreta para JWT
APP_JWT_EXPIRATION_MS=86400000     # Tiempo de expiración del token JWT en milisegundos (1 día)
